<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowBoardVideoCalls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CallHub derives from Microsoft.AspNetCore.SignalR.Hub, whose types
         (IHubCallerClients, HubCallerContext, IGroupManager) live in the
         ASP.NET Core shared framework. This test project uses plain
         Sdk="Microsoft.NET.Sdk" (not Sdk="Microsoft.NET.Sdk.Web" like the
         main project), so it needs this FrameworkReference explicitly to
         see those types. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>