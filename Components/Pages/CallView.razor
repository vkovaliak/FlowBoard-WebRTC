@page "/call/{RoomId}"
@using FlowBoardVideoCalls.Configuration
@using FlowBoardVideoCalls.Models
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<WebRtcOptions> WebRtcOptions
@inject ILogger<CallView> Logger
@implements IAsyncDisposable

<PageTitle>FlowBoard Video Calls — @RoomId</PageTitle>

<div class="call-view">
    <div class="topbar">
        <span class="room-id-display font-mono" @onclick="CopyRoomIdAsync">
            Room: @RoomId <span class="copy-icon">⧉</span>
        </span>
        @if (_copied)
        {
            <span class="copy-confirmation">Copied!</span>
        }
    </div>

    @if (_activeSharerId is not null)
    {
        <ScreenShareLayout SharerDisplayName="@ActiveSharerDisplayName" IsLocalSharer="@IsActiveSharer">
            <VideoTile DisplayName="@(DisplayName ?? "Guest")"
                        IsLocal="true"
                        HasMedia="@LocalHasVideo"
                        IsPermissionDenied="@(_hasMediaAccess == false)"
                        ShowSettingsHint="_showSettingsHint"
                        IsMuted="_isMicMuted" />

            @foreach (var participant in _participants)
            {
                <VideoTile @key="participant.ConnectionId"
                            ConnectionId="@participant.ConnectionId"
                            DisplayName="@participant.DisplayName"
                            IsLocal="false"
                            HasMedia="@(!_camerasOff.Contains(participant.ConnectionId))"
                            HasConnectionIssue="@_connectionIssues.Contains(participant.ConnectionId)"
                            IsMuted="@_mutedParticipants.Contains(participant.ConnectionId)" />
            }
        </ScreenShareLayout>
    }
    else
    {
        <div class="roster-area">
            <div class="tile-strip @GridSizeClass">
                <VideoTile DisplayName="@(DisplayName ?? "Guest")"
                            IsLocal="true"
                            HasMedia="@LocalHasVideo"
                            IsPermissionDenied="@(_hasMediaAccess == false)"
                            ShowSettingsHint="_showSettingsHint"
                            IsMuted="_isMicMuted" />

                @* Remote camera-off is real (ParticipantCameraChanged). Remote
                   permission-denied still can't be distinguished from voluntary
                   camera-off (no callback carries that distinction across
                   participants) -- known gap, flagged since Story 2.5, not fixed here. *@
                @foreach (var participant in _participants)
                {
                    <VideoTile @key="participant.ConnectionId"
                                ConnectionId="@participant.ConnectionId"
                                DisplayName="@participant.DisplayName"
                                IsLocal="false"
                                HasMedia="@(!_camerasOff.Contains(participant.ConnectionId))"
                                HasConnectionIssue="@_connectionIssues.Contains(participant.ConnectionId)"
                                IsMuted="@_mutedParticipants.Contains(participant.ConnectionId)" />
                }
            </div>

            @if (_participants.Count == 0)
            {
                <p class="waiting-message">Waiting for others to join…</p>
            }
        </div>
    }

    <ControlBar HasMediaAccess="@(_hasMediaAccess == true)"
                IsMuted="_isMicMuted"
                IsCameraOn="_isCameraOn"
                IsSharing="@IsActiveSharer"
                IsShareDisabled="@(_activeSharerId is not null && !IsActiveSharer)"
                SharerDisplayName="@ActiveSharerDisplayName"
                OnToggleMic="ToggleMicAsync"
                OnToggleCamera="ToggleCameraAsync"
                OnToggleShareScreen="ToggleShareScreenAsync"
                OnHangUp="HangUpAsync" />
</div>

@code {
    [Parameter]
    public string RoomId { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "name")]
    public string? DisplayName { get; set; }

    private readonly List<ParticipantDto> _participants = new();

    /// <summary>ConnectionIds currently showing the Connection Issue Badge
    /// (FR-10), muted (FR-15), or camera-off (FR-16). All three are local UI
    /// state driven by JS callbacks, not server truth carried on
    /// ParticipantDto -- deliberately kept separate from the roster list.</summary>
    private readonly HashSet<string> _connectionIssues = new();
    private readonly HashSet<string> _mutedParticipants = new();
    private readonly HashSet<string> _camerasOff = new();

    private DotNetObjectReference<CallView>? _dotNetRef;
    private bool _copied;

    /// <summary>null = not yet resolved; true = granted; false = denied (Avatar Placeholder).</summary>
    private bool? _hasMediaAccess;
    private bool _hasAttemptedRetry;
    private bool _showSettingsHint;

    /// <summary>Local Control Bar toggle state. Never learned from the hub --
    /// SetMuteState/SetCameraState broadcast to OthersInGroup only, so this
    /// client never receives its own ParticipantMuteChanged/CameraChanged
    /// (Story 1.3's CallHub excludes the caller). These fields are the only
    /// source of truth for my own button state and my own tile.</summary>
    private bool _isMicMuted;
    private bool _isCameraOn = true;

    /// <summary>My own connectionId, learned once via a one-time JS callback
    /// (OnLocalConnectionIdKnown) right after the hub connection starts.
    /// Unlike mute/camera, SetSharingState's CallHub broadcast goes to the
    /// WHOLE group including the caller -- so "am I the active sharer" is
    /// derived from the same _activeSharerId every other participant uses,
    /// not a separate optimistic flag.</summary>
    private string? _myConnectionId;

    /// <summary>The current active sharer's connectionId, or null if no one
    /// is sharing (FR-11/FR-13). Source of truth for both the layout branch
    /// (Grid vs ScreenShareLayout) and the Share Screen control's
    /// disabled/tooltip state for every participant, including the sharer.</summary>
    private string? _activeSharerId;

    private bool IsActiveSharer => _activeSharerId is not null && _activeSharerId == _myConnectionId;

    private string? ActiveSharerDisplayName
    {
        get
        {
            if (_activeSharerId is null)
            {
                return null;
            }

            if (_activeSharerId == _myConnectionId)
            {
                return DisplayName ?? "Guest";
            }

            return _participants.FirstOrDefault(p => p.ConnectionId == _activeSharerId)?.DisplayName;
        }
    }

    /// <summary>Local video shows only when media access is granted AND the
    /// camera hasn't been toggled off -- composes Story 2.1's permission
    /// gate with Story 2.5's toggle state.</summary>
    private bool LocalHasVideo => _hasMediaAccess == true && _isCameraOn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetRef = DotNetObjectReference.Create(this);

        var iceServers = WebRtcOptions.Value.IceServers
            .Select(s => new { urls = s.Urls })
            .ToArray();

        await InvokeJsSafelyAsync("initializeCall", _dotNetRef, RoomId, DisplayName ?? "Guest", iceServers);
    }

    /// <summary>Total tiles including self. Drives the CSS breakpoint class
    /// (FR-19): 1 = large single tile, 2 = side-by-side, 3-4 = 2x2,
    /// 5+ = expanding grid with a min-tile-width floor + scroll
    /// (DESIGN.md/EXPERIENCE.md Responsive &amp; Platform). No participant
    /// cap exists anywhere (AD-5, FR-9) -- this switch has an unbounded
    /// default case rather than an upper limit.</summary>
    private int TileCount => _participants.Count + 1;

    private string GridSizeClass => TileCount switch
    {
        1 => "grid-1",
        2 => "grid-2",
        3 or 4 => "grid-quad",
        _ => "grid-many",
    };

    [JSInvokable]
    public void OnLocalConnectionIdKnown(string connectionId)
    {
        _myConnectionId = connectionId;
    }

    [JSInvokable]
    public void OnParticipantJoined(ParticipantDto participant)
    {
        if (_participants.All(p => p.ConnectionId != participant.ConnectionId))
        {
            _participants.Add(participant);

            // Story 3.2: a late joiner's JoinRoom snapshot already carries
            // IsSharing for anyone mid-share (CallHub.ToDto), so the
            // screen-share-priority layout can switch on immediately --
            // this doesn't need to wait for the second stream to arrive
            // over the new RTCPeerConnection (Track-completeness corollary
            // handles that separately, in webrtc-mesh.js).
            if (participant.IsSharing)
            {
                _activeSharerId = participant.ConnectionId;
            }

            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnParticipantLeft(string connectionId)
    {
        _participants.RemoveAll(p => p.ConnectionId == connectionId);
        _connectionIssues.Remove(connectionId);
        _mutedParticipants.Remove(connectionId);
        _camerasOff.Remove(connectionId);
        StateHasChanged();
    }

    /// <summary>Toggles the Connection Issue Badge for exactly one peer
    /// (FR-10, AD-8) -- webrtc-mesh.js reports this from a handler scoped to
    /// a single RTCPeerConnection, so this callback never touches any other
    /// participant's state. Purely informational: no retry action exists.</summary>
    [JSInvokable]
    public void OnConnectionIssue(string connectionId, bool hasIssue)
    {
        if (hasIssue)
        {
            _connectionIssues.Add(connectionId);
        }
        else
        {
            _connectionIssues.Remove(connectionId);
        }

        StateHasChanged();
    }

    /// <summary>FR-15: mirrors another participant's mute state onto their
    /// tile only.</summary>
    [JSInvokable]
    public void OnParticipantMuteChanged(string connectionId, bool isMuted)
    {
        if (isMuted)
        {
            _mutedParticipants.Add(connectionId);
        }
        else
        {
            _mutedParticipants.Remove(connectionId);
        }

        StateHasChanged();
    }

    /// <summary>FR-16: mirrors another participant's camera state onto
    /// their tile only -- swaps to the Avatar Placeholder, never a frozen
    /// frame, since HasMedia flips off entirely rather than just hiding the
    /// video element.</summary>
    [JSInvokable]
    public void OnParticipantCameraChanged(string connectionId, bool isCameraOn)
    {
        if (isCameraOn)
        {
            _camerasOff.Remove(connectionId);
        }
        else
        {
            _camerasOff.Add(connectionId);
        }

        StateHasChanged();
    }

    /// <summary>FR-11/FR-13: fires for EVERY participant including the
    /// sharer (Story 1.3's CallHub broadcasts to the whole group), so this
    /// one callback drives the layout branch, the Share Screen disabled
    /// state, and the tooltip's sharer name for everyone from a single
    /// source of truth.
    ///
    /// Bug 2 fix (AD-1): any exception thrown from a [JSInvokable] method is
    /// fatal to the whole Blazor circuit by default -- this callback fires
    /// on every renegotiation-driven layout switch, so it must never be
    /// able to take the circuit down for a transient/unexpected state.</summary>
    [JSInvokable]
    public void OnScreenShareStateChanged(string? sharerConnectionId)
    {
        try
        {
            _activeSharerId = sharerConnectionId;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OnScreenShareStateChanged failed for sharerConnectionId={SharerConnectionId}", sharerConnectionId);
        }
    }

    /// <summary>Reports the outcome of the initial getUserMedia prompt *and*
    /// every retryMediaPermission() attempt (Signaling &amp; Interop Contract).
    /// Distinguishing "first denial" from "retry denial" -- and therefore
    /// when to show the browser-settings hint -- is tracked here in C#, not
    /// in JS, so media.js stays a dumb reporter of granted/denied only.</summary>
    [JSInvokable]
    public void OnMediaPermissionResult(bool granted)
    {
        _hasMediaAccess = granted;

        if (granted)
        {
            _showSettingsHint = false;
        }
        else if (_hasAttemptedRetry)
        {
            _showSettingsHint = true;
        }

        StateHasChanged();
    }

    /// <summary>Story 2.1's retry affordance and this story's mute toggle
    /// share one Control Bar button: while media access isn't granted,
    /// clicking Mic retries permission instead of toggling mute.</summary>
    private async Task ToggleMicAsync()
    {
        if (_hasMediaAccess != true)
        {
            await RetryMediaPermissionAsync();
            return;
        }

        _isMicMuted = !_isMicMuted;
        await InvokeJsSafelyAsync("toggleMic");
    }

    /// <summary>Same dual-purpose pattern as ToggleMicAsync, for the Camera button.</summary>
    private async Task ToggleCameraAsync()
    {
        if (_hasMediaAccess != true)
        {
            await RetryMediaPermissionAsync();
            return;
        }

        _isCameraOn = !_isCameraOn;
        await InvokeJsSafelyAsync("toggleCamera");
    }

    private async Task RetryMediaPermissionAsync()
    {
        _hasAttemptedRetry = true;
        await InvokeJsSafelyAsync("retryMediaPermission", _dotNetRef);
    }

    /// <summary>FR-11/FR-13: only reachable when no one else is sharing
    /// (ControlBar disables the button otherwise, and guards the click
    /// itself since the button can't carry a real `disabled` attribute --
    /// see ControlBar.razor). No local optimistic flag is flipped here:
    /// _activeSharerId updates only once OnScreenShareStateChanged reports
    /// back from the hub.</summary>
    private async Task ToggleShareScreenAsync()
    {
        if (IsActiveSharer)
        {
            await InvokeJsSafelyAsync("stopScreenShare");
        }
        else if (_activeSharerId is null)
        {
            await InvokeJsSafelyAsync("startScreenShare");
        }
    }

    /// <summary>FR-18: JS tears down every peer connection and local media,
    /// then stops the hub connection (triggering OnDisconnectedAsync server-
    /// side). Navigation back to Room Entry is this method's job, not JS's
    /// (AD-1: navigation is a C# concern). Always navigates away, even if
    /// the JS-side teardown itself failed -- the user's Hang Up click must
    /// still return them to Room Entry.</summary>
    private async Task HangUpAsync()
    {
        await InvokeJsSafelyAsync("hangUp");
        Nav.NavigateTo("/");
    }

    private async Task CopyRoomIdAsync()
    {
        await InvokeJsSafelyAsync("navigator.clipboard.writeText", RoomId);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
        StateHasChanged();
    }

    /// <summary>Bug 2 fix (AD-1): the sole point every user-triggered JS
    /// interop call in this component goes through. getDisplayMedia can
    /// reject (user cancels the share picker), a hub round-trip inside the
    /// JS call can fault, or the JS itself can throw -- any of those, left
    /// unhandled, surfaces in C# as a JSException thrown out of an event
    /// handler, which is fatal to the whole Blazor circuit by default.
    /// Catching here means a recoverable JS-side failure ends that one
    /// action instead of ending the call for everyone.</summary>
    private async Task InvokeJsSafelyAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "JS interop call '{Identifier}' failed", identifier);
        }
    }

    public ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
